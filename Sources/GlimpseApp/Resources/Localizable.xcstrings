    "Chosen details that do not fit this card size are left out; larger cards show more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Details, die nicht in diese Kartengröße passen, werden weggelassen; größere Karten zeigen mehr."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles elegidos que no caben en este tamaño de tarjeta se omiten; las tarjetas más grandes muestran más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails choisis qui ne tiennent pas dans cette taille de carte sont omis ; les cartes plus grandes en affichent davantage."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails choisis qui ne tiennent pas dans cette taille de carte sont omis; les cartes plus grandes en affichent davantage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードサイズに収まらない詳細は省略されます。大きいカードほど多く表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드 크기에 맞지 않는 세부 정보는 생략되며, 큰 카드일수록 더 많이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes escolhidos que não cabem neste tamanho de cartão são omitidos; cartões maiores mostram mais."
          }
        }
      }
    },
