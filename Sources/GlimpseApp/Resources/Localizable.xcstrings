            "value": "Unités de capacité"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Unités de capacité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量の単位"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 단위"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades de capacidade"
          }
        }
      }
    },
    "Capacity units apply to memory and disk sizes; bandwidth units to upload/download rates and the network ceiling. SI uses powers of 1000, IEC powers of 1024.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapazitätseinheiten gelten für Speicher- und Festplattengrößen, Bandbreiteneinheiten für Upload- und Downloadraten sowie den Netzwerk-Höchstwert. SI nutzt Potenzen von 1000, IEC Potenzen von 1024."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las unidades de capacidad se aplican a los tamaños de memoria y disco; las de ancho de banda, a las tasas de subida y descarga y al tope de red. SI usa potencias de 1000; IEC, potencias de 1024."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les unités de capacité s’appliquent aux tailles de mémoire et de disque ; les unités de débit, aux taux d’envoi et de réception et au plafond réseau. Le SI utilise des puissances de 1000, la CEI des puissances de 1024."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les unités de capacité s’appliquent aux tailles de mémoire et de disque; les unités de débit, aux taux d’téléversement et de téléchargement et au plafond réseau. Le SI utilise des puissances de 1000, la CEI des puissances de 1024."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量の単位はメモリとディスクのサイズに、帯域幅の単位はアップロード/ダウンロード速度とネットワークの上限に適用されます。SIは1000の累乗、IECは1024の累乗です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 단위는 메모리와 디스크 크기에, 대역폭 단위는 업로드/다운로드 속도와 네트워크 상한에 적용됩니다. SI는 1000의 거듭제곱, IEC는 1024의 거듭제곱을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As unidades de capacidade se aplicam aos tamanhos de memória e disco; as de largura de banda, às taxas de upload e download e ao teto da rede. O SI usa potências de 1000; o IEC, potências de 1024."
          }
        }
      }
    },
