    "%@ is unavailable. The selection is kept for when it returns.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht verfügbar. Die Auswahl bleibt erhalten, bis es wieder verfügbar ist."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está disponible. La selección se conserva para cuando vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas disponible. La sélection est conservée pour son retour."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas disponible. La sélection est conservée pour son retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は利用できません。再び利用可能になったときのために選択は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 사용할 수 없습니다. 다시 사용할 수 있게 될 때를 위해 선택이 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está disponível. A seleção é mantida para quando voltar."
          }
        }
      }
    },
