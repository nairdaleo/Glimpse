    "Works from any app. Use at least one of ⌘, ⌥ or ⌃; Esc cancels recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert in jeder App. Verwende mindestens eine der Tasten ⌘, ⌥ oder ⌃; Esc bricht die Eingabe ab."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona desde cualquier app. Usa al menos una de las teclas ⌘, ⌥ o ⌃; Esc cancela la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne depuis n’importe quelle app. Utilise au moins une des touches ⌘, ⌥ ou ⌃ ; Échap annule la saisie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne depuis n’importe quelle app. Utilise au moins une des touches ⌘, ⌥ ou ⌃; Échap annule la saisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも使えます。⌘、⌥、⌃のいずれかを含めてください。Escで入力を取り消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서나 작동합니다. ⌘, ⌥, ⌃ 중 하나 이상을 포함하세요. Esc를 누르면 입력이 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona em qualquer app. Use pelo menos uma das teclas ⌘, ⌥ ou ⌃; Esc cancela a captura."
          }
        }
      }
    },
