#!/bin/sh
# Blocks a push when betterleaks finds a secret in the commits being pushed.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

if ! command -v betterleaks >/dev/null 2>&1; then
    echo "pre-push: betterleaks is not installed, so the secret scan cannot run. Install it: brew install betterleaks" >&2
    exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                       # deleting a ref pushes no content
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"                        # new branch or tag: commits not on any remote yet
    else
        range="$remote_sha..$local_sha"
    fi
    if ! betterleaks git --no-banner --redact --log-level warn --log-opts="$range" . ; then
        echo "pre-push: possible secret in commits for $remote_ref. Remove it from history before pushing." >&2
        echo "pre-push: a false positive can be allowed with a 'betterleaks:allow' comment on that line or a .betterleaksignore entry." >&2
        status=1
    fi
done
exit $status
